---
import { clampRating, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <div class="flex items-center">
        <span class="rounded-full bg-[var(--color-accent)]/10 px-3 py-1 text-sm text-[var(--color-link)]" data-testid="game-rating">
            <span aria-hidden="true">{formatStarRating(rating)}</span>
            <span class="sr-only">Rating:</span>
            {clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
