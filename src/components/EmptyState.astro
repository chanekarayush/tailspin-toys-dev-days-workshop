---
interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div
    data-testid="empty-state"
    class="theme-panel-subtle rounded-xl py-12 text-center backdrop-blur-sm"
>
    {text ? (
        <p data-testid="empty-state-text" class="theme-copy">{text}</p>
    ) : (
        <slot />
    )}
</div>
