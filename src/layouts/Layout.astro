---
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text-primary)] transition-colors duration-300 m-0 w-full h-full font-sans">
        <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
            <div class="retro-ambient retro-ambient-left">
                <img src="/assets/game-console.png" alt="" class="retro-asset retro-asset-left" />
            </div>
            <div class="retro-ambient retro-ambient-right">
                <img src="/assets/ghost.png" alt="" class="retro-asset retro-asset-right" />
            </div>

            <div class="retro-icon-field" aria-hidden="true">
                <svg class="retro-route-layer" viewBox="0 0 1200 800" preserveAspectRatio="none">
                    <path id="route-a" class="retro-route" d="M 0 180 H 160 V 90 H 320 V 220 H 480 V 100 H 640 V 240 H 800 V 110 H 960 V 210 H 1120 V 800 H 1200" />

                    <g class="retro-route-entity">
                        <image href="/assets/gamer.png" x="-20" y="-20" width="40" height="40" preserveAspectRatio="xMidYMid meet" />
                        <animateMotion dur="42s" repeatCount="indefinite" rotate="auto">
                            <mpath href="#route-a" />
                        </animateMotion>
                    </g>

                    <g class="retro-route-entity">
                        <image href="/assets/ghost.png" x="-24" y="-24" width="48" height="48" preserveAspectRatio="xMidYMid meet" />
                        <animateMotion dur="50s" begin="2s" repeatCount="indefinite" rotate="auto">
                            <mpath href="#route-a" />
                        </animateMotion>
                    </g>

                    <g class="retro-route-entity">
                        <image href="/assets/ghost-2.png" x="-24" y="-24" width="48" height="48" preserveAspectRatio="xMidYMid meet" />
                        <animateMotion dur="56s" begin="4s" repeatCount="indefinite" rotate="auto">
                            <mpath href="#route-a" />
                        </animateMotion>
                    </g>
                </svg>
            </div>
        </div>
        <Header />
        <main class="arcade-grid container relative z-10 mx-auto min-h-[calc(100vh-5rem)] max-w-7xl py-6">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
        <footer class="border-t border-[var(--color-border-default)] bg-[var(--color-surface)]/90 px-4 py-6 text-center text-sm text-[var(--color-text-muted)]">
            <p>Built for curious players, thoughtful creators, and better game nights.</p>
        </footer>

        <div
            id="wishlist-toast"
            class="pointer-events-none fixed bottom-5 right-5 z-50 hidden w-[min(22rem,calc(100vw-2rem))] rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface)]/95 p-4 shadow-[var(--shadow-elevated)] backdrop-blur-sm"
            data-testid="wishlist-toast"
            role="status"
            aria-live="polite"
        >
            <div class="flex items-start justify-between gap-3">
                <div>
                    <p class="arcade-kicker mb-1 text-[0.6rem] font-bold uppercase">Saved</p>
                    <p class="theme-heading text-sm font-semibold" data-testid="wishlist-toast-message">Added to your wishlist</p>
                </div>
                <button
                    type="button"
                    class="pointer-events-auto rounded-full border border-[var(--color-border-default)] px-2 py-1 text-[0.65rem] font-semibold uppercase text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-text-primary)]"
                    aria-label="Dismiss wishlist notification"
                    data-testid="wishlist-toast-dismiss"
                >
                    Close
                </button>
            </div>
            <a
                href={`${baseUrl}wishlist`}
                class="pointer-events-auto mt-3 inline-flex items-center rounded-lg bg-[var(--color-accent)] px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-[var(--color-accent-hover)] focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)]"
                data-testid="wishlist-toast-link"
            >
                View wishlist
            </a>
        </div>

        <script is:inline>
            const root = document.documentElement;
            const storedTheme = localStorage.getItem('tailspin-theme');
            const preferredTheme = storedTheme || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            root.classList.toggle('light', preferredTheme === 'light');
            root.classList.toggle('dark', preferredTheme === 'dark');

            const wishlistToast = document.getElementById('wishlist-toast');
            const wishlistToastMessage = document.querySelector('[data-testid="wishlist-toast-message"]');
            const wishlistToastLink = document.querySelector('[data-testid="wishlist-toast-link"]');
            const wishlistToastDismiss = document.querySelector('[data-testid="wishlist-toast-dismiss"]');

            const hideWishlistToast = () => {
                if (!wishlistToast) return;
                wishlistToast.classList.add('hidden');
            };

            const showWishlistToast = (detail = {}) => {
                if (!wishlistToast || !wishlistToastMessage || !wishlistToastLink) return;
                const title = detail.title ? `${detail.title} added` : 'Game added';
                wishlistToastMessage.textContent = title;
                wishlistToast.classList.remove('hidden');
                if (wishlistToastDismiss) {
                    wishlistToastDismiss.onclick = hideWishlistToast;
                }
                window.clearTimeout(showWishlistToast.timeoutId);
                showWishlistToast.timeoutId = window.setTimeout(hideWishlistToast, 5000);
            };

            window.addEventListener('tailspin-wishlist-added', (event) => {
                const detail = event.detail || {};
                showWishlistToast(detail);
            });

            if (wishlistToastDismiss) {
                wishlistToastDismiss.addEventListener('click', hideWishlistToast);
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }

    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }

    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>
