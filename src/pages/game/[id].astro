---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import StarRating from '../../components/StarRating.astro';
import Tag from '../../components/Tag.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import GameArtwork from '../../components/GameArtwork.astro';
import ArrowLeft from '../../assets/icons/arrow-left.svg';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
import Heart from '../../assets/icons/heart.svg';
import { getDatabase } from '../../lib/db';
import { getAllGameIds, getGameById } from '../../lib/games';

export const prerender = true;

export const getStaticPaths = (async () => {
    const ids = await getAllGameIds(getDatabase());
    return ids.map((id) => ({ params: { id: String(id) } }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const game = await getGameById(getDatabase(), Number(id));

if (!game) {
    return Astro.redirect('/404');
}
---

<Layout title="Game Details - Tailspin Toys">
  <div class="py-8">
    <Card class="arcade-outline overflow-hidden rounded-2xl" data-testid="game-details">
      <div class="p-6">
        <div class="mb-6 grid gap-5 md:grid-cols-[0.75fr_1.25fr] md:items-center">
          <div class="overflow-hidden rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-muted)] p-3">
            <img src="/assets/arcade-machine.png" alt="Retro arcade machine illustration" class="retro-card-art h-52 w-full rounded-xl object-cover sm:h-60" />
          </div>

          <div>
            <p class="arcade-kicker mb-3 text-xs font-bold uppercase">Now loading into the table</p>
            <div class="flex justify-between items-start flex-wrap gap-3">
              <h1 class="theme-heading mb-2 text-3xl font-bold" data-testid="game-details-title">{game.title}</h1>

              <StarRating rating={game.starRating} />
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              {game.category && (
                <Tag color="blue" data-testid="game-details-category">
                  {game.category.name}
                </Tag>
              )}
              {game.publisher && (
                <a href={`/publisher/${game.publisher.id}`} data-testid="game-details-publisher-link">
                  <Tag color="purple" data-testid="game-details-publisher">{game.publisher.name}</Tag>
                </a>
              )}
            </div>
          </div>
        </div>

        {(game.category?.description || game.publisher?.description) && (
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {game.category?.description && (
              <section class="theme-panel-subtle rounded-xl p-5" data-testid="game-details-category-description">
                <h2 class="theme-heading mb-2 text-lg font-semibold">About {game.category.name}</h2>
                <p class="theme-copy">{game.category.description}</p>
              </section>
            )}
            {game.publisher?.description && (
              <section class="theme-panel-subtle rounded-xl p-5" data-testid="game-details-publisher-description">
                <h2 class="theme-heading mb-2 text-lg font-semibold">About {game.publisher.name}</h2>
                <p class="theme-copy">{game.publisher.description}</p>
              </section>
            )}
          </div>
        )}

        <div class="space-y-4 mt-6">
          <h2 class="theme-heading mb-2 text-lg font-semibold">About this game</h2>
          <div class="theme-copy space-y-4">
            <p data-testid="game-details-description">{game.description}</p>
          </div>
        </div>

        <div class="mt-8 rounded-xl border border-[var(--color-border-default)] bg-[var(--color-surface-muted)] p-4">
          <p class="theme-copy-muted mb-3 text-sm">Ready to make this your next game night?</p>
          <Button
            variant="gradient"
            fullWidth
            data-testid="back-game-button"
            data-game-id={game.id}
            data-game-title={game.title}
            data-game-description={game.description}
            data-game-rating={game.starRating ?? ''}
            data-game-category-id={game.category?.id ?? ''}
            data-game-category-name={game.category?.name ?? ''}
            data-game-publisher-id={game.publisher?.id ?? ''}
            data-game-publisher-name={game.publisher?.name ?? ''}
          >
            <Heart class="h-5 w-5 mr-2" aria-hidden="true" />
            <span data-testid="support-game-button-label">Support This Game</span>
          </Button>
        </div>
      </div>
    </Card>

    <div class="mt-8">
      <Button href={baseUrl} size="sm">
        <ArrowLeft class="h-5 w-5 mr-2" aria-hidden="true" />
        Back to all games
      </Button>
    </div>
  </div>
</Layout>

<script>
  import { addGameToWishlist, isGameSaved } from '../../lib/wishlist';

  const supportButton = document.querySelector<HTMLButtonElement>('[data-testid="back-game-button"]');
  const supportButtonLabel = document.querySelector<HTMLElement>('[data-testid="support-game-button-label"]');

  const sourceGame = {
    id: Number(supportButton?.dataset.gameId),
    title: supportButton?.dataset.gameTitle ?? '',
    description: supportButton?.dataset.gameDescription ?? '',
    starRating: supportButton?.dataset.gameRating ? Number(supportButton.dataset.gameRating) : null,
    category: supportButton?.dataset.gameCategoryId
      ? {
          id: Number(supportButton.dataset.gameCategoryId),
          name: supportButton.dataset.gameCategoryName ?? '',
          description: null,
        }
      : null,
    publisher: supportButton?.dataset.gamePublisherId
      ? {
          id: Number(supportButton.dataset.gamePublisherId),
          name: supportButton.dataset.gamePublisherName ?? '',
          description: null,
        }
      : null,
  };

  const syncSupportButton = (): void => {
    if (!supportButton || !supportButtonLabel || !Number.isFinite(sourceGame.id)) {
      return;
    }

    const alreadySaved = isGameSaved(sourceGame.id, window.localStorage);
    supportButton.disabled = alreadySaved;
    supportButton.classList.toggle('opacity-75', alreadySaved);
    supportButton.classList.toggle('cursor-not-allowed', alreadySaved);
    supportButtonLabel.textContent = alreadySaved ? 'Added to Wishlist' : 'Support This Game';
  };

  if (supportButton) {
    supportButton.addEventListener('click', () => {
      addGameToWishlist(sourceGame, window.localStorage);
      syncSupportButton();
      window.dispatchEvent(new CustomEvent('tailspin-wishlist-updated'));
      window.dispatchEvent(new CustomEvent('tailspin-wishlist-added', {
        detail: {
          title: sourceGame.title,
          gameId: sourceGame.id,
        },
      }));
    });
  }

  syncSupportButton();
</script>
