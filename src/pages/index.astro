---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers, getCatalogSummary } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
const catalogSummary = await getCatalogSummary(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 grid gap-4 md:grid-cols-2" data-testid="catalog-summary" aria-label="Catalog summary">
      <div class="theme-panel rounded-xl p-6">
        <p class="theme-copy-muted text-sm font-medium uppercase tracking-[0.12em]">Games in catalog</p>
        <p class="theme-heading mt-3 text-3xl font-semibold" data-testid="catalog-total-games">
          {catalogSummary.totalGames}
        </p>
      </div>

      <div class="theme-panel rounded-xl p-6">
        <p class="theme-copy-muted text-sm font-medium uppercase tracking-[0.12em]">Average rating</p>
        <p class="theme-heading mt-3 text-3xl font-semibold" data-testid="catalog-average-rating">
          {catalogSummary.averageRating === null ? 'No ratings yet' : `${catalogSummary.averageRating.toFixed(2)} / 5`}
        </p>
      </div>
    </div>

    <div>
      <h2 class="theme-heading mb-6 text-2xl font-medium">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="theme-panel-subtle mb-8 grid gap-6 rounded-xl p-6 md:grid-cols-[1fr_16rem] md:items-start"
            data-testid="game-filters"
            role="search"
            aria-describedby="filter-description"
          >
            <div>
              <label for="game-search" class="theme-heading mb-2 block text-lg font-medium">Search games by title</label>
              <input
                id="game-search"
                name="title"
                type="search"
                placeholder="Search by title"
                autocomplete="off"
                data-testid="game-search-input"
                class="mb-6 w-full rounded-lg border border-[var(--color-border-default)] bg-[var(--color-surface)] px-4 py-3 text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)]"
              />

              <fieldset>
                <legend class="theme-heading mb-2 text-lg font-medium">Filter by category</legend>
                <p id="filter-description" class="theme-copy-muted mb-4 text-sm">
                  Select one or more categories. Results can also be narrowed by publisher.
                </p>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-[var(--color-border-default)] px-3 py-2 text-sm text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent)] focus-within:ring-2 focus-within:ring-[var(--color-focus)]">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 accent-[var(--color-accent)]"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </div>

            <div class="flex flex-col gap-2">
              <label for="game-sort" class="theme-heading text-lg font-medium">Sort games</label>
              <select
                id="game-sort"
                data-testid="game-sort"
                class="rounded-lg border border-[var(--color-border-default)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-text-primary)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)]"
              >
                <option value="title-asc">Title (A-Z)</option>
                <option value="title-desc">Title (Z-A)</option>
                <option value="rating-desc">Rating (highest first)</option>
              </select>
              <label for="publisher-filter" class="theme-heading text-lg font-medium">Filter by publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="rounded-lg border border-[var(--color-border-default)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-text-primary)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)]"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
              <button
                type="reset"
                class="mt-2 self-start rounded-lg border border-[var(--color-border-default)] px-3 py-2 text-sm font-medium text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-surface-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)]"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
          </form>

          <p class="theme-copy-muted mb-4 text-sm" data-testid="filter-results-count" role="status" aria-live="polite">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>
          <span class="sr-only" data-testid="game-search-status" aria-live="polite">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </span>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-game-card-wrapper
                data-category-id={game.category?.id ?? ''}
                data-publisher-id={game.publisher?.id ?? ''}
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div
            class="hidden"
            data-testid="filtered-empty-state"
            role="status"
            aria-live="polite"
          >
            <div data-testid="game-search-no-results">
              <EmptyState text="No games match your search." />
            </div>
          </div>
          <nav class="mt-8 flex items-center justify-between gap-4" aria-label="Game catalog pagination" data-testid="game-pagination">
            <button type="button" class="rounded-lg border border-[var(--color-border-default)] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)] disabled:cursor-not-allowed disabled:opacity-50" data-testid="previous-page">
              Previous
            </button>
            <span class="theme-copy-muted text-sm" data-testid="pagination-status" aria-live="polite"></span>
            <button type="button" class="rounded-lg border border-[var(--color-border-default)] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)] disabled:cursor-not-allowed disabled:opacity-50" data-testid="next-page">
              Next
            </button>
          </nav>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-game-card-wrapper]')];
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const searchStatus = document.querySelector<HTMLElement>('[data-testid="game-search-status"]');

  if (filterForm && emptyState && resultCount && searchStatus) {
    const searchInput = filterForm.querySelector<HTMLInputElement>('[data-testid="game-search-input"]');
    const categoryFilters = [...filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]')];
    const publisherFilter = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-testid="game-sort"]');
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const previousPage = document.querySelector<HTMLButtonElement>('[data-testid="previous-page"]');
    const nextPage = document.querySelector<HTMLButtonElement>('[data-testid="next-page"]');
    const paginationStatus = document.querySelector<HTMLElement>('[data-testid="pagination-status"]');
    const pageSize = 6;
    let currentPage = 1;

    const sortCards = (): void => {
      if (!sortSelect || !gamesGrid) return;
      const sortedCards = [...cards].sort((left, right) => {
        const leftGame = left.querySelector<HTMLElement>('[data-game-title]');
        const rightGame = right.querySelector<HTMLElement>('[data-game-title]');
        const leftTitle = leftGame?.dataset.gameTitle ?? '';
        const rightTitle = rightGame?.dataset.gameTitle ?? '';
        if (sortSelect.value === 'rating-desc') {
          const leftRating = Number(leftGame?.dataset.gameRating);
          const rightRating = Number(rightGame?.dataset.gameRating);
          if (Number.isNaN(leftRating) && Number.isNaN(rightRating)) return leftTitle.localeCompare(rightTitle);
          if (Number.isNaN(leftRating)) return 1;
          if (Number.isNaN(rightRating)) return -1;
          return rightRating - leftRating || leftTitle.localeCompare(rightTitle);
        }
        const comparison = leftTitle.localeCompare(rightTitle);
        return sortSelect.value === 'title-desc' ? -comparison : comparison;
      });
      sortedCards.forEach((card) => gamesGrid.append(card));
    };

    const updateResults = (): void => {
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      const selectedCategories = categoryFilters.filter((filter) => filter.checked).map((filter) => filter.value);
      const selectedPublisher = publisherFilter?.value ?? '';
      sortCards();
      let visibleCount = 0;
      const matchingCards: HTMLElement[] = [];

      cards.forEach((card) => {
        const titleMatches = (card.querySelector<HTMLElement>('[data-game-title]')?.dataset.gameTitle ?? '')
          .toLocaleLowerCase()
          .includes(query);
        const categoryMatches =
          selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId ?? '');
        const publisherMatches = selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
        const isVisible = titleMatches && categoryMatches && publisherMatches;

        if (isVisible) {
          matchingCards.push(card);
          visibleCount += 1;
        } else {
          card.hidden = true;
        }
      });

      const totalPages = Math.max(1, Math.ceil(matchingCards.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      matchingCards.forEach((card, index) => {
        card.hidden = index < (currentPage - 1) * pageSize || index >= currentPage * pageSize;
      });
      if (previousPage && nextPage && paginationStatus) {
        previousPage.disabled = currentPage === 1;
        nextPage.disabled = currentPage === totalPages;
        paginationStatus.textContent = `Page ${currentPage} of ${totalPages}`;
      }
      emptyState.classList.toggle('hidden', visibleCount > 0);
      const statusText = query
        ? `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} found`
        : `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      resultCount.textContent = statusText;
      searchStatus.textContent = statusText;
    };

    filterForm.addEventListener('input', updateResults);
    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => {
      currentPage = 1;
      requestAnimationFrame(updateResults);
    });
    sortSelect?.addEventListener('change', updateResults);
    previousPage?.addEventListener('click', () => {
      currentPage = Math.max(1, currentPage - 1);
      updateResults();
    });
    nextPage?.addEventListener('click', () => {
      currentPage += 1;
      updateResults();
    });
    updateResults();
  }
</script>
