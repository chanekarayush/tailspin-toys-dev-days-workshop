---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5" data-testid="game-filters">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-300">
                  <input type="checkbox" name="category" value={category.name} class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500" data-testid={`filter-category-${category.id}`} />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="min-w-56">
            <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Filter by publisher</label>
            <select id="publisher-filter" name="publisher" class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="filter-publisher">
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.name}>{publisher.name}</option>)}
            </select>
          </div>

          <button type="reset" class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="filter-reset">
            Clear filters
          </button>
        </div>
        <p class="mt-4 text-sm text-slate-400" aria-live="polite" data-testid="filter-status">
          Showing {games.length} {games.length === 1 ? 'game' : 'games'}
        </p>
      </form>

      <div class:list={['grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6', { hidden: games.length === 0 }]} data-testid="games-grid">
        {games.map((game) => (
          <div data-filter-category={game.category?.name ?? ''} data-filter-publisher={game.publisher?.name ?? ''} data-filter-card>
            <GameCard game={game} />
          </div>
        ))}
      </div>
      <div class:list={[{ hidden: games.length > 0 }]} data-testid="no-games">
        <EmptyState text="No games available at the moment." />
      </div>
      <div class="hidden" data-testid="no-filtered-games">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const filterCards = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-card]'));
  const filterStatus = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const noFilteredGames = document.querySelector<HTMLElement>('[data-testid="no-filtered-games"]');

  function applyFilters(): void {
    if (!filterForm || !filterStatus || !noFilteredGames) return;
    const selectedCategories = new Set(Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')).map((input) => input.value));
    const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
    let visibleCount = 0;

    filterCards.forEach((card) => {
      const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.filterCategory ?? '');
      const publisherMatches = selectedPublisher === '' || card.dataset.filterPublisher === selectedPublisher;
      card.hidden = !categoryMatches || !publisherMatches;
      if (!card.hidden) visibleCount += 1;
    });

    noFilteredGames.classList.toggle('hidden', visibleCount > 0);
    filterStatus.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
  }

  filterForm?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
</script>
