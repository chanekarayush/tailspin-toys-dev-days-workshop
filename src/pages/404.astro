---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import ArrowLeft from '../assets/icons/arrow-left.svg';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Page Not Found - Tailspin Toys">
  <div class="py-16">
    <Card as="section" class="max-w-xl mx-auto text-center shadow-lg p-10" data-testid="not-found">
      <p class="mb-4 text-6xl font-bold text-[var(--color-link)]">404</p>
      <h1 class="theme-heading mb-3 text-2xl font-semibold" data-testid="not-found-heading">Page not found</h1>
      <p class="theme-copy-muted mb-8" data-testid="not-found-text">
        We couldn&apos;t find the page you were looking for. It may have been removed or the link is incorrect.
      </p>
      <Button href={baseUrl} data-testid="not-found-home-link">
        <ArrowLeft class="h-5 w-5 mr-2" aria-hidden="true" />
        Back to all games
      </Button>
    </Card>
  </div>
</Layout>
